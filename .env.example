# Steam username for the dedicated server download + cached logins.
# Passwords are intentionally NOT taken from the environment - enter them
# once in the control panel (http://host:8080); the login token is then
# persisted on the steam volume and reused automatically.
STEAM_USERNAME=your-steam-username

# Game Server Login Token from Steam (for server authentication)
# Get a token at https://steamcommunity.com/dev/managegameservers
STEAM_GSLT=your-gslt-token

# Control panel port and (recommended if exposed) basic-auth password
PANEL_PORT=8080
PANEL_PASSWORD=

# Start the game server automatically once files are installed (true/false)
AUTO_START=true
